#!/bin/bash

export PATH="/opt/homebrew/bin:$PATH"
file="$HOME/.sidetone"
default=96
step=16
usage="Usage: $0 [0-128|up|down] (no argument re-applies the level saved in $file)"

sidetone() {
  local volume=$(( $1 > 128 ? 128 : $1 ))
  (( volume < 0 )) && volume=0
  echo "Setting volume $volume"
  echo -n "$volume" > "$file"
  if ! output=$(headsetcontrol -s "$volume" 2>&1); then
    echo "$output"
    exit 0
  fi
}

current() {
  local value=$(cat "$file" 2>/dev/null)
  if [[ $value =~ ^[0-9]+$ ]]; then
    echo "$value"
  else
    echo "$default"
  fi
}

case "$1" in
  [0-9]*) 
    [[ $1 =~ ^[0-9]+$ ]] || { echo "$usage"; exit 1; }
    sidetone "$1" ;;
  up)   sidetone $(( $(current) + step )) ;;
  down) sidetone $(( $(current) - step )) ;;
  "")   sidetone "$(current)" ;;
  *)    echo "$usage"; exit 1 ;;
esac
