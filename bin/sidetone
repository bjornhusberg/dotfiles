#!/bin/bash

export PATH="/opt/homebrew/bin:$PATH"
statefile="$HOME/.sidetone"
default=96
step=16
usage="Usage: $0 [0-128|up|down]"

sidetone() {
  local volume=$(( $1 > 128 ? 128 : $1 ))
  (( volume < 0 )) && volume=0
  echo "$volume"
  echo -n "$volume" > "$statefile"
  if ! output=$(headsetcontrol -s "$volume" 2>&1); then
    echo "$output"
    exit 1
  fi
}

current() {
  local value=$(cat "$statefile" 2>/dev/null)
  if [[ $value =~ ^[0-9]+$ ]]; then
    echo "$value"
  else
    echo "$default"
  fi
}

case "$1" in
  [0-9]*) 
    [[ $1 =~ ^[0-9]+$ ]] || { echo "$usage"; exit 1; }
    sidetone "$1" ;;
  up)   sidetone $(( $(current) + step )) ;;
  down) sidetone $(( $(current) - step )) ;;
  "")   sidetone $(current) ;;
  *)    echo "$usage"; exit 1 ;;
esac
